body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #FAFAFA;
    color: #2B2B2B;
}

header {
    background-color: #E91E63;
    color: white;
    padding: 40px;
    text-align: center;
}

.tagline {
    font-size: 1.2rem;
    opacity: 0.9;
}

nav {
    background-color: #2B2B2B;
    padding: 10px;
    text-align: center;
}

nav a {
    color: #FAFAFA;
    margin: 0 15px;
    text-decoration: none;
    font-weight: 600;
}

nav a:hover {
    color: #E91E63;
}

.hero {
    padding: 60px;
    text-align: center;
}

h2 {
    color: #E91E63;
}
